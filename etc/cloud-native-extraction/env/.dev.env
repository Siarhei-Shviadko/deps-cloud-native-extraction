ENV=development

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=cloud-native-extraction
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps

# kafka
KAFKA_GROUP_ID=cloud-native-extraction

EXTRACTION_URL=http://deps-extraction:8000
DOCUMENT_TYPE_URL=http://deps-document-type:8000
DOCUMENT_URL=http://deps-document-api:8000
UNIFIER_URL=http://deps-unifier:8000

AZURE_VAULT_URL=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Auth
AUTH_VERIFY_SSL=false

ASB_SUBSCRIPTION_NAME=cloud-native-extraction

# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=cloud-native-extraction
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://otlp:4317
OTLP_TRACE_ENDPOINT=http://otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=connection_string
